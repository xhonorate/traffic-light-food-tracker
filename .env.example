# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# Everything prefixed VITE_ is bundled into the client. That is expected for
# Firebase web config (it is not a secret); access is governed by Firestore
# rules and App Check, not by hiding these values.
# ---------------------------------------------------------------------------

# Firebase web app config -> Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SDK at the local emulator suite during development
VITE_USE_EMULATORS=false
