{
  "name": "traffic-light-food-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "test:rules": "esbuild scripts/rule-parity.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rule-parity.mjs --log-level=error && node node_modules/.cache/rule-parity.mjs",
    "test:goals": "esbuild scripts/goals-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/goals-check.mjs --log-level=error && node node_modules/.cache/goals-check.mjs",
    "test:rank": "esbuild scripts/food-rank.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/food-rank.mjs --log-level=error && node node_modules/.cache/food-rank.mjs",
    "test:categories": "esbuild scripts/categories-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/categories-check.mjs --log-level=error && node node_modules/.cache/categories-check.mjs",
    "test:barcode": "esbuild scripts/barcode-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/barcode-check.mjs --log-level=error && node node_modules/.cache/barcode-check.mjs",
    "test": "npm run test:rules && npm run test:goals && npm run test:rank && npm run test:categories && npm run test:barcode",
    "categories:build": "esbuild scripts/build-categories.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-categories.mjs --log-level=error && node node_modules/.cache/build-categories.mjs",
    "test:usda": "esbuild scripts/usda-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/usda-check.mjs --log-level=error && node node_modules/.cache/usda-check.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "firebase": "^12.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
